# Turnu Măgurele Civic — variabilele de mediu ale serverului (Faza 5.1).
# Lista și regulile: docs/faza4/FAZA_4_00_ARHITECTURA_SI_INDEX.md §5.
#
# Copiați fișierul în `.env` (în rădăcina proiectului) și completați valorile.
# `.env` NU intră niciodată în Git. Aici nu există valori reale.
# Pe staging (fără Terminal): toate variabilele de mai jos stau într-un singur fișier, în afara oricărui
# docroot, cu drepturi 600; aplicația Node și comenzile cron primesc numai calea lui:
#   CIVIC_ENV_FILE=/home2/<cont>/civic-test-data/civic.env   (decizia tehnică 5.1-A)
#
# Generarea unui secret (32 de octeți, hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Mediu ---
APP_ENV=development            # development | staging | production
HOST=127.0.0.1                 # 0.0.0.0 pentru acces de pe telefon prin Wi-Fi (numai dezvoltare)
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000   # singurul loc cu domeniul; https în afara dezvoltării

# --- Bază de date (utilizator dedicat, drepturi numai pe DB-ul Civic) --- SECRET
DATABASE_URL=mysql://UTILIZATOR:PAROLA@127.0.0.1:3306/civic_dev

# --- Fișiere (fotografii), în afara docroot-ului ---
STORAGE_DIR=./storage

# --- Backup (backup:db / restore:db), în afara oricărui docroot ---
BACKUP_DIR=./backups

# --- Proxy de încredere: gol / false, true, număr de hop-uri sau listă de adrese ---
TRUST_PROXY=

# --- Secrete (obligatorii; minimum 32 de caractere) ---
IP_HASH_SECRET=
PARTICIPATION_HMAC_SECRET=     # nu se rotește cât timp există sondaje deschise
FORM_TOKEN_SECRET=
POW_HMAC_KEY=
TOTP_ENC_KEY=                  # exact 32 de octeți: 64 de caractere hex sau base64

# --- E-mail (folosit din 5.5) ---
EMAIL_MODE=simulated           # simulated | allowlist | live
EMAIL_ALLOWLIST=               # obligatorie pentru allowlist; adrese separate prin virgulă
MAIL_FROM=
CIVIC_MAIL_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=                     # SECRET

# --- Hartă și geocodare (folosite din 5.4) ---
UAT_BOUNDARY_FILE=
GEOCODER_URL=
GEOCODER_USER_AGENT=

# --- Autentificarea cetățeanului cu Google (amendamentul Google, G-T7) ---
# Ambele sau niciuna. Fără ele, butonul Google nu apare și rutele răspund 404.
# Secretul NU intră niciodată în repository; numai în civic.env pe server.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# NUMAI pentru testele automate (E2E), pe calculatorul de dezvoltare: furnizorul de identitate fals.
# Nu se scrie niciodată în civic.env: cu APP_ENV=staging sau production, aplicația refuză să pornească dacă există.
# Se acceptă numai http://localhost:<port> sau http://127.0.0.1:<port> și numai dacă și PUBLIC_BASE_URL este o adresă locală.
# DEV_OIDC_PROVIDER_URL=

# --- Retenție (valori aprobate; nu se pot seta mai sus) ---
RETENTION_DAYS=45
ADMIN_RETENTION_MONTHS=6

# --- Jurnale ---
LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace | silent
